This file is NOT read by the site. It only shows the entry format to copy into papers.bib.
Entries with `selected = {true}` appear in the "selected publications" block on the home page.
BibTeX `%` comments are not supported by jekyll-scholar, so keep papers.bib free of comment lines.

@article{sun2026example,
  title       = {Paper title},
  author      = {Sun, Haoran and Yang, Heng},
  journal     = {arXiv preprint arXiv:2601.00000},
  year        = {2026},
  arxiv       = {2601.00000},
  pdf         = {https://arxiv.org/pdf/2601.00000},
  code        = {https://github.com/Haoran1828/repo},
  preview     = {example.png},
  abbr        = {arXiv},
  bibtex_show = {true},
  selected    = {true}
}
